<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_view_form" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.linkdot_health_check</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- anchor: <div name="button_box"> in hr/views/hr_employee_views.xml -->
            <div name="button_box" position="inside">
                <button name="action_open_health_checks" type="object" class="oe_stat_button"
                        icon="fa-stethoscope" groups="linkdot_health_check.group_health_check_officer">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="health_check_count"/></span>
                        <span class="o_stat_text">Health Checks</span>
                    </div>
                </button>
            </div>
        </field>
    </record>
</odoo>
