<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_health_check" model="ir.module.category">
        <field name="name">Health Checks</field>
        <field name="parent_id" ref="base.module_category_human_resources"/>
        <field name="sequence">50</field>
    </record>

    <!-- 健康檢查結果屬個資法的特種個人資料：只有健康管理人員看得到全部紀錄 -->
    <record id="group_health_check_officer" model="res.groups">
        <field name="name">Officer: Manage all health checks</field>
        <field name="category_id" ref="module_category_health_check"/>
        <!-- 不連帶 HR 權限：健康管理人員只透過「員工健檢狀況」看到生日等必要欄位 -->
        <field name="implied_ids" eval="[(3, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="group_health_check_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_health_check"/>
        <field name="implied_ids" eval="[(4, ref('group_health_check_officer'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="linkdot_health_check_rule_own" model="ir.rule">
        <field name="name">Health checks: employees see their own</field>
        <field name="model_id" ref="model_linkdot_health_check"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="linkdot_health_check_rule_officer" model="ir.rule">
        <field name="name">Health checks: officers see all</field>
        <field name="model_id" ref="model_linkdot_health_check"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_health_check_officer'))]"/>
    </record>

    <record id="linkdot_health_check_rule_company" model="ir.rule">
        <field name="name">Health checks: multi-company</field>
        <field name="model_id" ref="model_linkdot_health_check"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="linkdot_health_check_employee_status_rule_company" model="ir.rule">
        <field name="name">Employee health check status: multi-company</field>
        <field name="model_id" ref="model_linkdot_health_check_employee_status"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="linkdot_health_check_report_rule_own" model="ir.rule">
        <field name="name">Health check reports: employees see their own</field>
        <field name="model_id" ref="model_linkdot_health_check_report"/>
        <field name="domain_force">[('check_id.employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="linkdot_health_check_report_rule_officer" model="ir.rule">
        <field name="name">Health check reports: officers see all</field>
        <field name="model_id" ref="model_linkdot_health_check_report"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_health_check_officer'))]"/>
    </record>

    <record id="linkdot_health_check_report_rule_company" model="ir.rule">
        <field name="name">Health check reports: multi-company</field>
        <field name="model_id" ref="model_linkdot_health_check_report"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="linkdot_health_check_provider_rule_company" model="ir.rule">
        <field name="name">Medical institutions: multi-company</field>
        <field name="model_id" ref="model_linkdot_health_check_provider"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
