<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 員工健檢狀況總覽：依下次應檢日找出逾期 / 即將到期 / 從未健檢的人 -->
    <record id="linkdot_health_check_employee_status_view_list" model="ir.ui.view">
        <field name="name">linkdot.health.check.employee.status.list</field>
        <field name="model">linkdot.health.check.employee.status</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="department_id"/>
                <field name="job_title" optional="show"/>
                <field name="birthday" optional="show"/>
                <field name="last_health_check_date"/>
                <field name="next_health_check_date"/>
                <field name="health_check_status" widget="badge"
                       decoration-success="health_check_status == 'ok'"
                       decoration-warning="health_check_status in ('due_soon', 'no_record')"
                       decoration-danger="health_check_status == 'overdue'"/>
                <field name="health_check_count" optional="show"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="linkdot_health_check_employee_status_view_form" model="ir.ui.view">
        <field name="name">linkdot.health.check.employee.status.form</field>
        <field name="model">linkdot.health.check.employee.status</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_open_health_checks" type="object" class="oe_stat_button"
                                icon="fa-stethoscope">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="health_check_count"/></span>
                                <span class="o_stat_text">Health Checks</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <h2><field name="job_title"/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="department_id"/>
                            <field name="birthday"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="last_health_check_date"/>
                            <field name="next_health_check_date"/>
                            <field name="health_check_status" widget="badge"
                                   decoration-success="health_check_status == 'ok'"
                                   decoration-warning="health_check_status in ('due_soon', 'no_record')"
                                   decoration-danger="health_check_status == 'overdue'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="linkdot_health_check_employee_status_view_search" model="ir.ui.view">
        <field name="name">linkdot.health.check.employee.status.search</field>
        <field name="model">linkdot.health.check.employee.status</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="department_id"/>
                <filter name="overdue" string="Overdue"
                        domain="[('next_health_check_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="due_within_90" string="Due within 90 Days"
                        domain="[('next_health_check_date', '&lt;=', (context_today() + relativedelta(days=90)).strftime('%Y-%m-%d'))]"/>
                <filter name="no_record" string="No Record" domain="[('next_health_check_date', '=', False)]"/>
                <separator/>
                <filter name="missing_birthday" string="Missing Birthday" domain="[('birthday', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="linkdot_health_check_employee_status_action" model="ir.actions.act_window">
        <field name="name">Employee Health Check Status</field>
        <field name="res_model">linkdot.health.check.employee.status</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="linkdot_health_check_employee_status_view_search"/>
    </record>
</odoo>
