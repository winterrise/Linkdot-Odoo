<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.linkdot_health_check</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Health Checks" string="Health Checks" name="linkdot_health_check"
                     groups="linkdot_health_check.group_health_check_manager">
                    <block title="Health Checks" name="health_check_setting_container">
                        <setting id="health_check_reminder_days" string="Reminder Lead Time"
                                 help="Create a 'To Schedule' general health check this many days before it is due. Reminders go to everyone with the Health Checks 'Officer' access right (to Administrators only if there is no Officer).">
                            <field name="health_check_reminder_days" class="oe_inline"/> days
                        </setting>
                    </block>
                    <block title="Report Storage (Google Shared Drive)" name="health_check_drive_setting_container">
                        <setting id="health_check_drive" string="Shared Drive Folder"
                                 help="Scanned reports are stored only in this Shared Drive folder, in a sub-folder per year, named EmployeeNumber_CheckType_Date (e.g. 0013_一般健康檢查_20261022.pdf).">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="health_check_drive_folder" class="col-lg-4 o_light_label"/>
                                    <field name="health_check_drive_folder" class="col-lg-8"
                                           placeholder="https://drive.google.com/drive/folders/..."/>
                                </div>
                                <div class="row mt8">
                                    <label for="health_check_drive_credentials" class="col-lg-4 o_light_label"/>
                                    <field name="health_check_drive_credentials" password="True" class="col-lg-8"
                                           placeholder='{"type": "service_account", ...}'/>
                                </div>
                                <div class="row mt8" invisible="not health_check_drive_account">
                                    <label for="health_check_drive_account" class="col-lg-4 o_light_label"/>
                                    <field name="health_check_drive_account" class="col-lg-8" readonly="1"/>
                                </div>
                                <div class="mt8 text-muted small" invisible="not health_check_drive_account">
                                    Add this address to the Shared Drive as <b>Content manager</b>, save, then test the connection.
                                </div>
                                <div class="mt8">
                                    <button name="action_health_check_test_drive" type="object" string="Test Connection"
                                            icon="fa-plug" class="btn-link"
                                            invisible="not health_check_drive_folder or not health_check_drive_credentials"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
